{
  "$defs": {
    "Context": {
      "additionalProperties": false,
      "properties": {
        "repository": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Repository"
        },
        "files": {
          "items": {
            "type": "string"
          },
          "maxItems": 20,
          "title": "Files",
          "type": "array"
        },
        "text": {
          "default": "",
          "title": "Text",
          "type": "string"
        },
        "diff": {
          "default": "",
          "title": "Diff",
          "type": "string"
        }
      },
      "title": "Context",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "1.0",
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "task": {
      "maxLength": 50000,
      "minLength": 1,
      "title": "Task",
      "type": "string"
    },
    "context": {
      "$ref": "#/$defs/Context"
    },
    "mode": {
      "default": "brainstorm",
      "enum": [
        "brainstorm",
        "review",
        "handoff"
      ],
      "title": "Mode",
      "type": "string"
    },
    "model": {
      "default": "consultant",
      "enum": [
        "consultant",
        "review",
        "research"
      ],
      "title": "Model",
      "type": "string"
    },
    "effort": {
      "anyOf": [
        {
          "enum": [
            "low",
            "medium",
            "high",
            "max"
          ],
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Effort"
    },
    "max_output_tokens": {
      "default": 4000,
      "maximum": 8000,
      "minimum": 1,
      "title": "Max Output Tokens",
      "type": "integer"
    },
    "consultation_id": {
      "anyOf": [
        {
          "pattern": "^[a-f0-9]{32}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Consultation Id"
    }
  },
  "required": [
    "task"
  ],
  "title": "Ask",
  "type": "object"
}
