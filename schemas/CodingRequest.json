{
  "$defs": {
    "Limits": {
      "additionalProperties": false,
      "properties": {
        "timeout_seconds": {
          "default": 1800,
          "maximum": 3600,
          "minimum": 1,
          "title": "Timeout Seconds",
          "type": "integer"
        },
        "max_output_tokens": {
          "default": 100000,
          "maximum": 1000000,
          "minimum": 1,
          "title": "Max Output Tokens",
          "type": "integer"
        }
      },
      "title": "Limits",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "1.0",
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "repository": {
      "title": "Repository",
      "type": "string"
    },
    "task": {
      "maxLength": 50000,
      "minLength": 1,
      "title": "Task",
      "type": "string"
    },
    "acceptance_criteria": {
      "items": {
        "type": "string"
      },
      "maxItems": 50,
      "minItems": 1,
      "title": "Acceptance Criteria",
      "type": "array"
    },
    "base_ref": {
      "default": "HEAD",
      "maxLength": 200,
      "pattern": "^[A-Za-z0-9_./-]+$",
      "title": "Base Ref",
      "type": "string"
    },
    "constraints": {
      "items": {
        "type": "string"
      },
      "title": "Constraints",
      "type": "array"
    },
    "verification_profile": {
      "title": "Verification Profile",
      "type": "string"
    },
    "limits": {
      "$ref": "#/$defs/Limits"
    },
    "client_request_id": {
      "anyOf": [
        {
          "maxLength": 200,
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Client Request Id"
    },
    "retry_of": {
      "anyOf": [
        {
          "pattern": "^[a-f0-9]{32}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Retry Of"
    }
  },
  "required": [
    "repository",
    "task",
    "acceptance_criteria",
    "verification_profile"
  ],
  "title": "CodingRequest",
  "type": "object"
}
